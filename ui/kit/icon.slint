// Line icons on a 24×24 grid, stroked with one solid color.
import { Theme } from "../theme.slint";

export component Icon {
    in property <string> name;
    in property <color> color: Theme.text;
    in property <length> size: 16px;
    in property <length> stroke: 1.5px;
    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        commands: root.name == "install" ? "M12 3 L12 15 M7 10 L12 15 L17 10 M4 20 L20 20"
            : root.name == "progress" ? "M9 6 L20 6 M9 12 L20 12 M9 18 L20 18 M4.5 6 L4.6 6 M4.5 12 L4.6 12 M4.5 18 L4.6 18"
            : root.name == "apps" ? "M4 4 L10 4 L10 10 L4 10 Z M14 4 L20 4 L20 10 L14 10 Z M4 14 L10 14 L10 20 L4 20 Z M14 14 L20 14 L20 20 L14 20 Z"
            : root.name == "runtimes" ? "M12 3 L21 8 L12 13 L3 8 Z M3 12 L12 17 L21 12 M3 16 L12 21 L21 16"
            : root.name == "settings" ? "M4 7 L20 7 M4 17 L20 17 M9 4 L9 10 M15 14 L15 20"
            : root.name == "more" ? "M5.5 12 L5.6 12 M12 12 L12.1 12 M18.5 12 L18.6 12"
            : root.name == "chevron-down" ? "M6 9 L12 15 L18 9"
            : root.name == "chevron-up" ? "M6 15 L12 9 L18 15"
            : root.name == "chevron-right" ? "M9 6 L15 12 L9 18"
            : root.name == "check" ? "M5 12.5 L10 17 L19 7"
            : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
            : root.name == "info" ? "M12 3 A9 9 0 1 1 11.99 3 M12 11 L12 17 M12 7.5 L12 7.6"
            : root.name == "warning" ? "M12 3 L22 20 L2 20 Z M12 9.5 L12 14 M12 17 L12 17.1"
            : root.name == "error" ? "M12 3 A9 9 0 1 1 11.99 3 M9 9 L15 15 M15 9 L9 15"
            : root.name == "success" ? "M12 3 A9 9 0 1 1 11.99 3 M8 12.5 L11 15.5 L16.5 9.5"
            : root.name == "play" ? "M7 4 L19 12 L7 20 Z"
            : root.name == "stop" ? "M6 6 L18 6 L18 18 L6 18 Z"
            : root.name == "refresh" ? "M20 12 A8 8 0 1 1 17.66 6.34 M20 3 L20 8 L15 8"
            : root.name == "trash" ? "M4 7 L20 7 M9 7 L9 4 L15 4 L15 7 M6 7 L7 20 L17 20 L18 7"
            : root.name == "folder" ? "M3 6 L9 6 L11 8 L21 8 L21 19 L3 19 Z"
            : root.name == "copy" ? "M8 8 L20 8 L20 20 L8 20 Z M4 16 L4 4 L16 4"
            : root.name == "document" ? "M6 3 L14 3 L19 8 L19 21 L6 21 Z M14 3 L14 8 L19 8"
            : root.name == "code" ? "M8 7 L3 12 L8 17 M16 7 L21 12 L16 17"
            : root.name == "save" ? "M5 4 L16 4 L20 8 L20 20 L4 20 L4 4 Z M8 4 L8 9 L15 9 L15 4 M8 20 L8 14 L16 14 L16 20"
            : root.name == "menu" ? "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
            : root.name == "launch" ? "M14 4 L20 4 L20 10 M20 4 L11 13 M18 14 L18 20 L4 20 L4 6 L10 6"
            : root.name == "package" ? "M12 3 L21 7.5 L21 16.5 L12 21 L3 16.5 L3 7.5 Z M3 7.5 L12 12 L21 7.5 M12 12 L12 21"
            : root.name == "globe" ? "M12 3 A9 9 0 1 1 11.99 3 M3 12 L21 12 M12 3 C8 7 8 17 12 21 M12 3 C16 7 16 17 12 21"
            : root.name == "sliders" ? "M4 7 L20 7 M4 17 L20 17 M9 4 L9 10 M15 14 L15 20"
            : root.name == "palette" ? "M12 3 A9 9 0 1 0 12 21 C13.5 21 14 20 13.5 18.5 C13 17 14 16 15.5 16 L18 16 C20 16 21 14.5 21 12 C21 7 17 3 12 3 Z M7.5 11 L7.6 11 M10 7 L10.1 7 M15 7.5 L15.1 7.5"
            : root.name == "link" ? "M10 14 L14 10 M8 12 L6 14 A3 3 0 0 0 10 18 L12 16 M16 12 L18 10 A3 3 0 0 0 14 6 L12 8"
            : root.name == "remove" ? "M6 12 L18 12"
            : root.name == "add" ? "M12 5 L12 19 M5 12 L19 12"
            // Caption button glyphs, drawn at 10 px with a 1 px stroke.
            : root.name == "chrome-minimize" ? "M1 12 L23 12"
            : root.name == "chrome-maximize" ? "M1 1 L23 1 L23 23 L1 23 Z"
            : root.name == "chrome-restore" ? "M1 6 L18 6 L18 23 L1 23 Z M6 6 L6 1 L23 1 L23 18 L18 18"
            : root.name == "chrome-close" ? "M1 1 L23 23 M23 1 L1 23"
            : "M12 3 A9 9 0 1 1 11.99 3";
    }
}
