// Windows 11 style palettes (installer-ui: Windows 11 visual language). Every brush here is
// a solid color; the UI never uses gradients.
import { Palette } from "std-widgets.slint";

export enum ThemeMode { system, light, dark }

export global Theme {
    // Set from Rust (config.toml); `system` follows the desktop color scheme.
    in-out property <ThemeMode> mode: ThemeMode.system;
    out property <bool> dark: mode == ThemeMode.dark || (mode == ThemeMode.system && Palette.color-scheme == ColorScheme.dark);

    // Surfaces
    out property <color> window-bg: dark ? #202020 : #F3F3F3;
    out property <color> card-bg: dark ? #2B2B2B : #FDFDFD;
    out property <color> card-bg-hover: dark ? #323232 : #F6F6F6;
    out property <color> card-stroke: dark ? #1D1D1D : #E5E5E5;
    out property <color> pane-bg: dark ? #202020 : #F3F3F3;
    out property <color> dialog-bg: dark ? #2B2B2B : #FFFFFF;
    out property <color> dialog-footer: dark ? #202020 : #F3F3F3;
    out property <color> smoke: dark ? #0000004D : #0000004D;
    out property <color> divider: dark ? #3A3A3A : #E5E5E5;

    // Text
    out property <color> text: dark ? #FFFFFF : #1A1A1A;
    out property <color> text-secondary: dark ? #CCCCCC : #5C5C5C;
    out property <color> text-disabled: dark ? #787878 : #A0A0A0;
    out property <color> text-on-accent: dark ? #000000 : #FFFFFF;

    // Accent
    out property <color> accent: dark ? #60CDFF : #005FB8;
    out property <color> accent-hover: dark ? #5AB9E6 : #1A6FBF;
    out property <color> accent-pressed: dark ? #52A5CC : #2B7AC4;
    out property <color> accent-disabled: dark ? #434343 : #BFBFBF;

    // Controls
    out property <color> control-bg: dark ? #2D2D2D : #FFFFFF;
    out property <color> control-bg-hover: dark ? #323232 : #F9F9F9;
    out property <color> control-bg-pressed: dark ? #272727 : #F5F5F5;
    out property <color> control-bg-disabled: dark ? #262626 : #F5F5F5;
    out property <color> control-stroke: dark ? #3C3C3C : #D6D6D6;
    out property <color> control-stroke-strong: dark ? #9A9A9A : #8A8A8A;
    out property <color> input-bg: dark ? #2D2D2D : #FFFFFF;
    out property <color> input-bg-focus: dark ? #1F1F1F : #FFFFFF;
    out property <color> subtle-hover: dark ? #2D2D2D : #EAEAEA;
    out property <color> subtle-pressed: dark ? #292929 : #EDEDED;
    out property <color> track-bg: dark ? #3C3C3C : #D6D6D6;
    out property <color> popup-bg: dark ? #2C2C2C : #F9F9F9;
    out property <color> popup-stroke: dark ? #1D1D1D : #D6D6D6;
    out property <color> focus-ring: dark ? #FFFFFF : #1A1A1A;

    // Status (InfoBar backgrounds and icons)
    out property <color> info-bg: dark ? #2B2B2B : #F6F6F6;
    out property <color> success-bg: dark ? #393D1B : #DFF6DD;
    out property <color> success: dark ? #6CCB5F : #0F7B0F;
    out property <color> caution-bg: dark ? #433519 : #FFF4CE;
    out property <color> caution: dark ? #FCE100 : #9D5D00;
    out property <color> critical-bg: dark ? #442726 : #FDE7E9;
    out property <color> critical: dark ? #FF99A4 : #C42B1C;

    // Shape
    out property <length> radius-card: 4px;
    out property <length> radius-control: 4px;
    out property <length> radius-dialog: 8px;

    // Type ramp (Inter)
    out property <string> font: "Inter";
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> subtitle: 20px;
    out property <length> title: 28px;
    out property <int> semibold: 600;
}

// Window size, for popups that must stay inside the window.
export global Metrics {
    in-out property <length> window-height: 800px;
}
